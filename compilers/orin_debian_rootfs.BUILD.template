load("@rules_cc//cc:defs.bzl", "cc_library")

filegroup(
    name = "sysroot_files",
    srcs = glob(
        include = [
            "include/**",
            "lib/**",
            "lib64/**",
            "usr/include/**",
            "usr/local/**",
            "usr/lib/**",
            "usr/lib64/**",
        ],
        exclude = [
            "lib/systemd/system/system-systemd*",
            "usr/lib/systemd/system/system-systemd*",
            "usr/share/**",
        ],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cuda_13_2_root",
    srcs = glob(["usr/local/cuda-13.2/**"]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "argus",
    srcs = [
        "usr/lib/libnvargus_socketclient.so",
    ],
    hdrs = glob(
        include = ["usr/include/Argus/**"],
    ),
    includes = ["usr/include/Argus/utils/"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "eglstream",
    hdrs = glob(
        include = ["usr/include/EGLStream/**"],
    ),
    includes = ["usr/include/EGLStream/"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvbufsurface",
    srcs = [
        "usr/lib/libnvbufsurface.so.1.0.0",
    ],
    visibility = ["//visibility:public"],
)

# NVIDIA's TEGRA_ACCELERATE build of libjpeg-8b, which drives the NVJPG
# engine.  Consumers must compile with -DTEGRA_ACCELERATE to get the
# matching struct layout.
cc_library(
    name = "nvjpeg",
    srcs = [
        "usr/lib/libnvjpeg.so",
    ],
    hdrs = glob(
        include = ["usr/include/libjpeg-8b/*.h"],
    ),
    includes = ["usr/include/libjpeg-8b/"],
    visibility = ["//visibility:public"],
)

# Note: the cudart target used to be defined here with hardcoded
# `usr/local/cuda-11.8/lib/libcudart.so.11.0` paths. It has been removed
# in favor of the version-aware target (e.g. `cudart-13.2`) that
# `generate_build_file()` auto-emits below from the pkgconfig entries
# shipped by the sysroot. Consumers in `//third_party:cudart` reference
# the versioned target so they track the Yocto/JetPack CUDA version
# without further hardcoded edits here.

cc_library(
    name = "tensorrt",
    hdrs = glob(["usr/include/NvInfer*.h"]),
    strip_include_prefix = "usr/include",
    visibility = ["//visibility:public"],
    deps = [
        ":usr_lib_libnvinfer.so.10.16.2-lib",
    ],
)

{{ RULES }}
